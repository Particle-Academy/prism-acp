{
    "name": "particle-academy/prism-acp",
    "description": "Agent Client Protocol for the signed-in Claude CLI from PHP. Initial Windows preview, with no third-party runtime dependencies.",
    "type": "library",
    "license": "MIT",
    "keywords": ["acp", "agent-client-protocol", "claude", "prism"],
    "homepage": "https://github.com/Particle-Academy/prism-acp",
    "support": {
        "issues": "https://github.com/Particle-Academy/prism-acp/issues",
        "source": "https://github.com/Particle-Academy/prism-acp"
    },
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "pestphp/pest": "^3.0|^4.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.7"
    },
    "autoload": {
        "psr-4": {
            "Prism\\Acp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": ["bin/prism-acp"],
    "scripts": {
        "test": "@php vendor/bin/pest",
        "types": "@php vendor/bin/phpstan analyse",
        "format": "@php vendor/bin/pint",
        "rector": "@php vendor/bin/rector process --dry-run"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
