{
  "reference": "@particle-academy/prism-acp 0.25.1",
  "scenarios": [
    {
      "name": "default-subscription",
      "provider": "claude",
      "expected": {
        "ok": true,
        "result": null
      }
    },
    {
      "name": "explicit-subscription",
      "provider": "codex",
      "credentials": {
        "mode": "subscription"
      },
      "expected": {
        "ok": true,
        "result": null
      }
    },
    {
      "name": "invalid-mode",
      "provider": "codex",
      "credentials": {
        "mode": "wrong"
      },
      "expected": {
        "ok": false,
        "message": "credentials.mode must be \"subscription\" or \"apiKey\""
      }
    },
    {
      "name": "invalid-key-0",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": null,
        "home": "@root/app"
      },
      "expected": {
        "ok": false,
        "message": "credentials.apiKey must be a non-empty key with no control characters"
      }
    },
    {
      "name": "invalid-key-1",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "",
        "home": "@root/app"
      },
      "expected": {
        "ok": false,
        "message": "credentials.apiKey must be a non-empty key with no control characters"
      }
    },
    {
      "name": "invalid-key-2",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": " ﻿ ",
        "home": "@root/app"
      },
      "expected": {
        "ok": false,
        "message": "credentials.apiKey must be a non-empty key with no control characters"
      }
    },
    {
      "name": "invalid-key-3",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy\nkey",
        "home": "@root/app"
      },
      "expected": {
        "ok": false,
        "message": "credentials.apiKey must be a non-empty key with no control characters"
      }
    },
    {
      "name": "invalid-key-4",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy\u0000key",
        "home": "@root/app"
      },
      "expected": {
        "ok": false,
        "message": "credentials.apiKey must be a non-empty key with no control characters"
      }
    },
    {
      "name": "invalid-key-5",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummykey",
        "home": "@root/app"
      },
      "expected": {
        "ok": false,
        "message": "credentials.apiKey must be a non-empty key with no control characters"
      }
    },
    {
      "name": "relative-home",
      "provider": "codex",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "relative"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home must be an absolute path"
      }
    },
    {
      "name": "file-home",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "@root/file"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home exists and is not a directory"
      }
    },
    {
      "name": "claude-default-home",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "@native/.claude"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home is this user's own claude configuration home: an API key there would replace or mix with their subscription login"
      }
    },
    {
      "name": "claude-moved-home",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "@root/moved/./x/../"
      },
      "parentEnv": {
        "claude_config_dir": "@root/moved"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home is this user's own claude configuration home: an API key there would replace or mix with their subscription login"
      }
    },
    {
      "name": "claude-app-home",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "arbitrary dummy token",
        "home": "@root/tenant/provider"
      },
      "expected": {
        "ok": true,
        "result": {
          "apiKey": "arbitrary dummy token",
          "home": "@root/tenant/provider"
        },
        "env": {
          "CLAUDE_CONFIG_DIR": "@root/tenant/provider",
          "ANTHROPIC_API_KEY": "arbitrary dummy token"
        }
      }
    },
    {
      "name": "claude-linked-home",
      "setup": "aliases",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "@root/alias"
      },
      "parentEnv": {
        "CLAUDE_CONFIG_DIR": "@root/moved"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home is this user's own claude configuration home: an API key there would replace or mix with their subscription login"
      }
    },
    {
      "name": "claude-chained-home",
      "setup": "aliases",
      "provider": "claude",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "@root/chain"
      },
      "parentEnv": {
        "CLAUDE_CONFIG_DIR": "@root/moved"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home is this user's own claude configuration home: an API key there would replace or mix with their subscription login"
      }
    },
    {
      "name": "codex-default-home",
      "provider": "codex",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "@native/.codex"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home is this user's own codex configuration home: an API key there would replace or mix with their subscription login"
      }
    },
    {
      "name": "codex-moved-home",
      "provider": "codex",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "@root/moved/./x/../"
      },
      "parentEnv": {
        "codex_home": "@root/moved"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home is this user's own codex configuration home: an API key there would replace or mix with their subscription login"
      }
    },
    {
      "name": "codex-app-home",
      "provider": "codex",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "arbitrary dummy token",
        "home": "@root/tenant/provider"
      },
      "expected": {
        "ok": true,
        "result": {
          "apiKey": "arbitrary dummy token",
          "home": "@root/tenant/provider"
        },
        "env": {
          "CODEX_HOME": "@root/tenant/provider"
        }
      }
    },
    {
      "name": "codex-linked-home",
      "setup": "aliases",
      "provider": "codex",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "@root/alias"
      },
      "parentEnv": {
        "CODEX_HOME": "@root/moved"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home is this user's own codex configuration home: an API key there would replace or mix with their subscription login"
      }
    },
    {
      "name": "codex-chained-home",
      "setup": "aliases",
      "provider": "codex",
      "credentials": {
        "mode": "apiKey",
        "apiKey": "dummy",
        "home": "@root/chain"
      },
      "parentEnv": {
        "CODEX_HOME": "@root/moved"
      },
      "expected": {
        "ok": false,
        "message": "credentials.home is this user's own codex configuration home: an API key there would replace or mix with their subscription login"
      }
    }
  ]
}
